# UXie configuration (docs/PRD.md §7). Copy to .env and fill in. Never commit .env.
# Every process validates this at boot (packages/core/src/env.ts) and refuses to start on errors.

# ── App ───────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info                                    # debug/trace refused in production (NFR-4)
ALLOWED_EMAIL_DOMAINS=thi.de,studmail.thi.de      # comma-separated; empty = any (dev only)
REGISTRATION_INVITE_CODE=                         # optional extra gate
PRIVACY_NOTICE_VERSION=2026-10-01
RESEARCH_CONSENT_VERSION=2026-10-01

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                              # server only; never exposed to the browser

# ── LLM provider ──────────────────────────────────────
# Bootstrap/development settings. Once the instructor saves the AI provider settings page
# (/admin/settings/ai, FR-9.6), the encrypted database settings take precedence over these.
# mock needs no key and is what tests use. For real dialogue set a provider and its key.
LLM_PROVIDER=mock                                 # anthropic | openai | google | openai_compatible | mock
LLM_STATE_PROVIDER=                               # provider for assessment + summaries; default LLM_PROVIDER
LLM_JUDGE_PROVIDER=                               # provider for the eval judge; default LLM_PROVIDER
LLM_BASE_URL=                                     # openai_compatible only (Ollama: http://localhost:11434/v1)
LLM_API_KEY=                                      # key of LLM_PROVIDER. Prod: Vercel + Render env, never in git
ANTHROPIC_API_KEY=                                # keys for providers used by other roles (mixed setups)
ANTHROPIC_WORKSPACE_ID=                           # only for org-level Anthropic keys not scoped to a workspace
OPENAI_API_KEY=
GEMINI_API_KEY=                                   # Gemini paid tier only (NFR-2)
SETTINGS_ENCRYPTION_KEY=                          # 32 bytes base64 (openssl rand -base64 32); encrypts keys saved in the admin page
LLM_TUTOR_MODEL=claude-sonnet-5-5                 # main reply model
LLM_STATE_MODEL=claude-haiku-4-5                  # assessment + summaries; defaults to LLM_TUTOR_MODEL
LLM_JUDGE_MODEL=claude-sonnet-5-5                 # eval judge; prefer a different model/vendor when available
LLM_CONTEXT_WINDOW=1000000                        # tokens of the tutor model (Sonnet 5.5: 1M; Haiku 4.5: 200K)
LLM_MAX_OUTPUT_TOKENS=2000                        # headroom for adaptive thinking
LLM_EFFORT=low                                    # anthropic: effort for tutor replies
LLM_TEMPERATURE=                                  # empty = provider default. MUST stay empty for claude-sonnet-5-5
LLM_CACHE_TTL=5m                                  # anthropic: 5m | 1h
LLM_TIMEOUT_MS=60000
ASSESSMENT_TIMEOUT_MS=8000
LLM_PRICES_JSON={"claude-sonnet-5-5":{"in":2,"cached":0.2,"write5m":2.5,"write1h":4,"out":10},"claude-haiku-4-5":{"in":1,"cached":0.1,"write5m":1.25,"write1h":2,"out":5}}
USD_TO_EUR=0.92

# ── Tutor behaviour ───────────────────────────────────
STUCK_THRESHOLD=3
HISTORY_TURNS=16                                  # verbatim messages kept in prompt
TUTOR_LANGUAGE=mirror                             # mirror | en
CONTEXT_STRATEGY=auto                             # auto | full | retrieval
RETRIEVAL_MAX_PAGES=8
TUTOR_MODES=understand,apply                      # focus modes offered; add critique,build to ship the P1 modes (D11)

# ── Limits & cost ─────────────────────────────────────
DAILY_TURN_LIMIT=120                              # per student
PER_MINUTE_TURN_LIMIT=8                           # per student
MONTHLY_SPEND_CEILING_EUR=100                     # stops new generation when exceeded
RETENTION_REVIEW_DATE=                            # optional ISO date; dashboard reminder (FR-8.4)

# ── Ingestion ─────────────────────────────────────────
EXTRACTOR=unpdf                                   # unpdf | docling
DOCLING_URL=                                      # worker only, e.g. http://uxie-docling:5001
MAX_PDF_MB=40
PAPER_TOKEN_WARN=60000

# ── Worker (Render) ───────────────────────────────────
WORKER_POLL_MS=5000
WORKER_JOB_TIMEOUT_MS=900000
ALERT_EMAIL=                                      # instructor address for spend/failure alerts (P1)
