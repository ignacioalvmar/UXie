{
  "name": "uxie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @uxie/web dev",
    "uxie": "pnpm --silent --filter @uxie/cli exec tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:seed-storage": "pnpm --filter @uxie/db seed:storage",
    "check": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm test:coverage",
    "test:e2e": "pnpm --filter @uxie/web build && pnpm --filter @uxie/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
